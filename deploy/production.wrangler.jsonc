{
  "name": "miaowu-english-production",
  "main": "../src/worker.js",
  "compatibility_date": "2026-10-30",
  "vars": {
    "APP_ENV": "production",
    "SELF_CLAIM_ENABLED": "true"
  },
  "assets": {
    "directory": "../dist-production/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miaowu-english-prod",
      "database_id": "649c71b3-340c-49bf-b806-3d39256851d3"
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
