{
  "name": "miaowu-english-production",
  "main": "../src/worker.js",
  "compatibility_date": "2026-10-30",
  "vars": {
    "APP_ENV": "production"
  },
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miaowu-english-prod",
      "database_id": "REPLACE_WITH_NEW_PRODUCTION_D1_ID"
    }
  ],
  "secrets": {
    "required": ["ACTIVATION_PEPPER"]
  }
}
